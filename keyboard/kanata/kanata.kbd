  lrld caps   lctl   lsft   lalt   @qwr      @gal    _    _    _    _   _ _ _
  _    @mback   @mwlft @mwdwn @mwup  @mwrgt home pgdn pgup end  _   _ _ _
  _    @mfwrd   @mleft @mmidl @mrght _      left down up   rght esc _ _
  _    @mvcl  @mvcd  @mvcu  @mvcr  _      _    _    _    _    _   _
  _    _    _             spc             _    _    _
)

