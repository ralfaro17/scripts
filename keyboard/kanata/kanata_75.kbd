;; ! The use of "multi" is mostly to send signals to overkeys in order to pick up special key presses

;; Windows AltGr behavior fix, sends a lctrl release when ralt is released
(defcfg
  windows-altgr add-lctl-release
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer qwerty
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv       1    2    3    4    5    6    7    8     9    0    -    =    bspc
  tab       q    w    e    r    t    y    u    i     o    p    [    ]    \
  @numpad   a    s    d    @nav1     g    h    @nav2 k    l    ;    '         ret
  lsft      z    x    c    v    b    n    m    ,     .    /    rsft
  lctl      lmet lalt           @sym                ralt rmet rctl
)

;; Gallium Rowstag angle modded
(deflayer gallium
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv   1    2    3    4    5     6    7    8      9    0    -    =    bspc
  tab       b    l    d    c      z    j    f      o    u    ,    [    ]    \
  @numpad   n    r    t    @navg1 v    y    @navg2 a    e    i    /         ret
  lsft      q    m    w    g      x    k    p      '    ;    .    rsft
  lctl lmet lalt           @sym                ralt rmet rctl
)

(defvirtualkeys
  ;; 1. The virtual key "holds" the layer
  v-numpad (layer-while-held numpad)
)

(defalias
  ;; tap: esc, hold: toggle layer-switching layer while held
  ;; grl (tap-hold 200 200 grv (layer-toggle layers))
  gal (multi rctl f23 (layer-switch gallium))
  qwr (multi rctl f24 (layer-switch qwerty))

  ;; layer keys
  nav1 (multi f13 (tap-hold 200 200 f (layer-while-held navigation1)))
  nav2 (multi f13 (tap-hold 200 200 j (layer-while-held navigation2)))
  navg1 (multi f13 (tap-hold 200 200 s (layer-while-held navigation1)))
  navg2 (multi f13 (tap-hold 200 200 h (layer-while-held navigation2)))
  sym (tap-hold 200 200 spc (layer-while-held symbols))
  numpad (tap-hold 200 200 caps (layer-while-held numpad))

  numpad-tg (multi f14 (on-press toggle-vkey v-numpad))

  ;; remaps 
  grvesc (tap-hold 300 150 grv esc)

)

(defvar
  mouse-wheel-interval 50
  mouse-wheel-distance 120 ;; 120 is the standard scroll distance
  mouse-wheel-distance-fast 580

  mouse-hold-timeout 300
  mouse-tap-repress-timeout 300

  mouse-move-interval 20
  mouse-move-distance 10

  ;; charmod template variables
  streak-count 3
  streak-time 325
  tap-timeout 200
  hold-timeout 300
  chord-timeout 50
)

(deftemplate charmod (char mod)
  (switch 
    ((key-timing $streak-count less-than $streak-time)) $char break
    () (tap-hold-release-timeout $tap-timeout $hold-timeout $char $mod $char reset-timeout-on-press) break
  )
)

(defalias
  ;; ---------- Layer actions ----------

  ;; mwlft (mwheel-left $mouse-wheel-interval $mouse-wheel-distance)
  ;; mwdwn (mwheel-down $mouse-wheel-interval $mouse-wheel-distance)
  ;; mwup  (mwheel-up $mouse-wheel-interval $mouse-wheel-distance)
  ;; mwrgt (mwheel-right $mouse-wheel-interval $mouse-wheel-distance)

  ;; mouse wheel utils
  mouse-wheel-left  (mwheel-left $mouse-wheel-interval $mouse-wheel-distance)
  mouse-wheel-down  (mwheel-down $mouse-wheel-interval $mouse-wheel-distance)
  mouse-wheel-up    (mwheel-up $mouse-wheel-interval $mouse-wheel-distance)
  mouse-wheel-right (mwheel-right $mouse-wheel-interval $mouse-wheel-distance)

  ;; mouse buttons
  mleft  (multi ctl f15 mlft)
  mmidl  (multi ctl f16 mmid)
  mrght  (multi ctl f17 mrgt)
  mback  (multi ctl f18 mbck)
  mfwrd  (multi ctl f19 mfwd) 

  ;; mouse wheel
  mwlft (multi (tap-hold $mouse-tap-repress-timeout $mouse-hold-timeout mwl @mouse-wheel-left))
  mwdwn (multi (tap-hold $mouse-tap-repress-timeout $mouse-hold-timeout mwd @mouse-wheel-down))
  mwup  (multi (tap-hold $mouse-tap-repress-timeout $mouse-hold-timeout mwu @mouse-wheel-up))
  mwrgt (multi (tap-hold $mouse-tap-repress-timeout $mouse-hold-timeout mwr @mouse-wheel-right))

  ;; move cursor
  mvcl (multi rctl f15 (movemouse-left $mouse-move-interval $mouse-move-distance))
  mvcd (multi rctl f16 (movemouse-down $mouse-move-interval $mouse-move-distance))
  mvcu (multi rctl f17 (movemouse-up $mouse-move-interval $mouse-move-distance))
  mvcr (multi rctl f18 (movemouse-right $mouse-move-interval $mouse-move-distance))
  
)

;; Legacy layer 
(deflayer layers
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    @qwr @gal _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

(deflayer navigation1
  _    _    _    _    _    _    _    _    _    _    _    _    _
  esc  XX   @qwr @gal XX  XX XX   XX   @qwr @gal XX   XX  XX  bspc
  _    XX   XX   XX   XX    XX home pgdn pgup end  del  XX  XX  lrld
  esc  lctl lsft lalt @nav1 XX left down up   rght ret  esc ret
  _    XX   XX   XX   XX    XX XX   XX   XX   XX   bspc _
  _    _    _             spc            _    _    _
)

(deflayer navigation2
  _    _      _      _      _      _      _    _     _    _    _    _   _
  esc  XX     @qwr   @gal   XX     XX     XX   XX    @qwr @gal XX   XX  XX bspc
  _    @mback @mwlft @mwdwn @mwup  @mwrgt XX   XX    XX   XX   XX   XX  XX lrld
  esc  @mfwrd @mleft @mmidl @mrght XX     XX   @nav2 ralt rsft rctl esc ret
  _    @mvcl  @mvcd  @mvcu  @mvcr  XX     XX   XX    XX   XX   XX   XX
  _    _    _             spc                        _    _    _
)

(deflayer symbols
  _    _    _     _    _    _    _    _    _    _    _    _    _
  esc  f1   f2    f3   f4   f5   f6   f7   f8   f9   f10  f11  f12   _
  _    grv  S-grv S-3  S-7  S-\  S-6  S-[  S-]  [    ]    XX   XX    lrld
  esc  S-1  S--   S-;  =    S-4  S-2  S-9  S-0  '    ;    esc  _
  _    S-5  S-/   S-8  S-=  \    /    -    S-,  S-.  S-'  _
  _    _    _              _              _    _    _
)

(deflayer numpad
  _        _    _    _    _     _  _    _           _    _    _    _   _
  esc      XX   @qwr @gal XX    XX XX   @numpad-tg  kp/  kp*  kp-  XX  XX  bspc
  _        XX   XX   XX   XX    XX XX   kp7         kp8  kp9  kp+  XX  XX  lrld
  @numpad  lctl lsft lalt XX    XX nlck kp4         kp5  kp6  kp+  esc ret
  _        XX   XX   XX   XX    XX kp0  kp1         kp2  kp3  ret  _
  _        _    _             spc                   _  _  ret
)

