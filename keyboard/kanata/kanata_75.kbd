;; 75% boards
;; Esc has its own key in the function row, so the top-left key of the
;; number row is a real grave and passes through unchanged.

;; Per-board so a board can add its own device options (e.g. linux-dev).
(defcfg
  ;; Windows AltGr fix: sends an lctl release when ralt is released
  windows-altgr add-lctl-release
  ;; Kept off on purpose: processing unmapped keys breaks AltGr on Windows.
  process-unmapped-keys no
)

(defalias
  esc-key esc
)

(include common.kbd)
